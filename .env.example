# Copy to .env and fill in. Never commit .env.

# OpenAI-compatible chat endpoint. Defaults below target Kimi (Moonshot AI);
# any other OpenAI-compatible provider works by changing these three values.
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=kimi-k2-0905-preview

# The moment the assistant treats as "now" for deadlines and opening hours.
# Format: ISO 8601 local date and time, YYYY-MM-DDTHH:MM, read in STORE_TIMEZONE.
# Default is the business day after the most recent order in the sample data.
REFERENCE_DATE=2026-03-23T10:00
# IANA timezone name of the store.
STORE_TIMEZONE=America/Campo_Grande

# Store database, conversation database and escalation log are created at
# runtime in ./runtime (git-ignored), separate from the read-only ./data.
